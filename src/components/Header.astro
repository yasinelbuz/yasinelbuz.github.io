---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav class="container">
		<div class="container-inline">
			<a href="/" class="logo">{SITE_TITLE}</a>
			<div class="internal-links">
				<HeaderLink href="/blog">Notlar</HeaderLink>
				<HeaderLink href="/projects">Projeler</HeaderLink>
				<HeaderLink href="/about">Hakkımda</HeaderLink>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 20px;
	}

	.logo {
		font-size: 2.5em;
		font-weight: 900;
	}

	.container-inline {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	a,
	a.active {
		text-decoration: none;
	}

	nav a {
		color: var(--black);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.6em;
	}

	.internal-links > a {
		margin: 0;
		padding: 0.3em 0.1em;
		font-size: 1.1em;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--black);
		transition: color 0.2s ease;
	}

	.internal-links > a:last-child {
		margin-right: 0px;
	}

	.internal-links > a:hover {
		color: var(--accent);
	}

	.internal-links > a.active {
		font-weight: 800;
		color: var(--accent);
	}
</style>
