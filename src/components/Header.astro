---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav class="container">
		<div>
			<a href="/">{SITE_TITLE}</a>
			<div class="internal-links">
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/projects">Projeler</HeaderLink>
				<HeaderLink href="/about">Hakkımda</HeaderLink>
			</div>
		</div>
		<div class="contact">
			<HeaderLink href="/contact">İletişim</HeaderLink>
			<svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"
				><path
					d="M4 11h12.17l-5.59-5.59L12 4l8 8-8 8-1.41-1.41L16.17 13H4z"
				></path></svg
			>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 20px;
		background: white;
	}
	h2 {
		margin: 0;
		font-size: 1.5em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
	}

	.internal-links > a {
		margin-right: 20px;
		font-weight: 300;
	}

	header .contact {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-weight: 600;
	}
	.contact-icon {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}
</style>
