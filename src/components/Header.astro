---
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav class="container">
		<div class="header-inner">
			<a href="/" class="logo">
				Yasin Elbüz
			</a>
			<div class="internal-links">
				<HeaderLink href="/">Notlar</HeaderLink>
				<HeaderLink href="/about">Hakkımda</HeaderLink>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 2em 0;
		background: transparent;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		font-size: 1.25em;
		font-weight: 500;
		color: rgb(var(--black));
		text-decoration: none;
		letter-spacing: 0.02em;
		font-family: var(--font-display);
		transition: opacity 0.2s ease;
	}

	.logo:hover {
		opacity: 0.7;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}

	.internal-links :global(a) {
		font-size: 0.9em;
		font-weight: 300;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: color 0.2s ease;
		position: relative;
	}

	.internal-links :global(a:hover) {
		color: rgb(var(--black));
	}

	.internal-links :global(a.active) {
		color: rgb(var(--black));
	}

	@media (max-width: 640px) {
		header {
			padding: 1.5em 0;
		}
		.header-inner {
			flex-direction: column;
			gap: 1em;
		}
	}
</style>
