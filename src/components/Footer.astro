---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const today = new Date();

const recentPosts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
---

<footer>
	<div class="container">
		<div class="columns">
			<div class="col">
				<h3>Keşfet</h3>
				<ul>
					<li><a href="/blog">Yazılar</a></li>
					<li><a href="/projects">Projeler</a></li>
					<li><a href="/deneyimler">Deneyimler</a></li>
					<li><a href="/about">Hakkımda</a></li>
					<li><a href="/su-an">Şu An</a></li>
				</ul>
			</div>

			<div class="col">
				<h3>İletişim</h3>
				<ul>
					<li>
						<a href="mailto:yasinelbuz@gmail.com"
							>yasinelbuz@gmail.com</a
						>
					</li>
				</ul>
			</div>

			<div class="col">
				<h3>Son Yazılar</h3>
				<ul>
					{
						recentPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.title}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<hr />

		<div class="social">
