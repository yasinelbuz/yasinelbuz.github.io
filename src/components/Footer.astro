<style>
	footer {
		margin-top: 4em;
		padding: 3em 0 4em 0;
		background: #fff;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	hr {
		border: none;
		border-top: 1px solid rgb(var(--black), 12%);
		margin: 2em 0;
	}
	.columns {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 3em;
	}
	.col h3 {
		margin: 0 0 0.9em;
		font-size: 0.78em;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.col ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.col li {
	}
	.col a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-weight: 300;
		letter-spacing: 0.01em;
		opacity: 0.85;
		transition:
			opacity 0.2s ease,
			color 0.2s ease;
	}
	.col a:hover {
		color: var(--accent);
		opacity: 1;
	}
	.post-date {
		display: block;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	.copyright {
		text-align: center;
		margin: 0;
		color: rgb(var(--gray));
	}
	.social {
		text-align: center;
	}
	.social h3 {
		margin: 0 0 0.9em;
		font-size: 0.78em;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.social ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5em;
	}
	.social a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		opacity: 0.8;
		transition:
			opacity 0.2s ease,
			color 0.2s ease;
	}
	.social a:hover {
		color: var(--accent);
		opacity: 1;
	}
	.social svg {
		width: 22px;
		height: 22px;
		display: block;
	}
	@media (max-width: 720px) {
		.columns {
			gap: 2em 2.5em;
		}
	}
</style>
