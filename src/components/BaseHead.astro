---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/blog-placeholder-1.jpg";
import { SITE_TITLE, SITE_URL, SITE_AUTHOR } from "../consts";

interface Props {
	title: string;
	description: string;
	/** Sayfa görseli — yerel ImageMetadata veya harici URL string kabul edilir */
	image?: ImageMetadata | string;
	/** Open Graph sayfası tipi: varsayılan 'website', blog yazılarında 'article' */
	ogType?: "website" | "article";
	/** Blog yazısı yayın tarihi (ogType='article' olduğunda kullanılır) */
	pubDate?: Date;
	/** Blog yazısı güncellenme tarihi */
	updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	ogType = "website",
	pubDate,
	updatedDate,
} = Astro.props;

// og:image URL'ini güvenli şekilde oluştur (hem yerel hem harici görsel desteklenir)
const ogImageUrl = (() => {
	if (!image) return new URL(FallbackImage.src, Astro.site).toString();
	if (typeof image === "string") {
		// Harici URL (https://) ise doğrudan kullan; aksi halde site URL'ine göreli ekle
		return image.startsWith("http")
			? image
			: new URL(image, Astro.site).toString();
	}
	// Yerel ImageMetadata objesi
	return new URL(image.src, Astro.site).toString();
})();

// JSON-LD: WebSite şeması (her sayfada)
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_AUTHOR,
	url: SITE_URL,
	description:
		"İstanbul'da yaşayan yazılım geliştiricisi Yasin Elbüz'ün kişisel blogu ve portfolyosu.",
	inLanguage: "tr-TR",
	author: {
		"@type": "Person",
		name: SITE_AUTHOR,
		url: SITE_URL,
	},
};

// JSON-LD: Person şeması (her sayfada)
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: SITE_AUTHOR,
	url: SITE_URL,
	jobTitle: "Frontend Engineer",
	description:
		"İstanbul'da yaşayan, JavaScript ekosistemi, mobil uygulama ve oyun geliştirme ile ilgilenen yazılım geliştiricisi.",
	knowsAbout: [
		"JavaScript",
		"TypeScript",
		"React",
		"Astro",
		"Mobile Development",
		"Game Development",
		"Web Development",
	],
	inLanguage: "tr-TR",
};

// JSON-LD: BlogPosting şeması (yalnızca ogType='article' sayfalarında)
const blogPostingSchema =
	ogType === "article"
		? {
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				headline: title,
				description: description,
				url: canonicalURL.toString(),
				...(pubDate && { datePublished: pubDate.toISOString() }),
				...(updatedDate || pubDate
					? { dateModified: (updatedDate ?? pubDate)!.toISOString() }
					: {}),
				author: {
					"@type": "Person",
					name: SITE_AUTHOR,
					url: SITE_URL,
				},
				publisher: {
					"@type": "Person",
					name: SITE_AUTHOR,
					url: SITE_URL,
				},
				image: ogImageUrl,
				inLanguage: "tr-TR",
				isPartOf: {
					"@type": "Blog",
					name: SITE_AUTHOR,
					url: SITE_URL,
				},
			}
		: null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />
<meta name="author" content={SITE_AUTHOR} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Amaranth:ital,wght@0,400;0,700;1,400;1,700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
	rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE_AUTHOR} />
<meta property="og:locale" content="tr_TR" />
{
	ogType === "article" && pubDate && (
		<meta
			property="article:published_time"
			content={pubDate.toISOString()}
		/>
	)
}
{
	ogType === "article" && updatedDate && (
		<meta
			property="article:modified_time"
			content={updatedDate.toISOString()}
		/>
	)
}
{ogType === "article" && <meta property="article:author" content={SITE_AUTHOR} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
{
	blogPostingSchema && (
		<script
			type="application/ld+json"
			set:html={JSON.stringify(blogPostingSchema)}
		/>
	)
}

<!-- Page transitions -->
<ClientRouter />
