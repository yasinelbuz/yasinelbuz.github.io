---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead
			title={`Hakkımda | ${SITE_TITLE}`}
			description="Üreten bir geliştirici: Yasin."
		/>
	</head>
	<body>
		<Header />
		<main class="about-page">
			<section class="about-hero">
				<div class="container about-hero__inner">
					<div class="about-hero__photo">
						<img src="/me.jpg" alt="Yasin Elbüz" />
					</div>
					<div class="about-hero__intro">
						<span class="about-eyebrow">Hakkında</span>
						<h1>Yasin Elbüz</h1>
						<p>
							Üreten bir geliştirici. Web, mobil ve ürün geliştirme
							üzerine çalışıyor; bir fikri mümkün olduğunca hayata
							geçirmeyi seviyorum.
						</p>
						<div class="about-actions">
							<a
								class="btn-primary"
								href="mailto:yasinelbuz@gmail.com">İletişim</a
							>
							<a class="btn-secondary" href="/projects">Projeler</a>
						</div>
					</div>
				</div>
			</section>

			<section class="about-details container">
				<div class="about-details__text">
					<h2>Hakkımda</h2>
					<p>
						Bir fikri sadece konuşmak yerine ürüne dönüştürmeyi
						seviyorum. Web ve mobil tarafında React, React Native ve
						TypeScript ile çalışırken; ara sıra küçük oyunlar ve
						ürün fikirleri de geliştiriyorum.
					</p>
					<p>
						Uzun vadede kendi yazılım şirketimi kurmayı
						hedefliyorum. Bu blog, o yolculuğun küçük bir arşivi.
					</p>
				</div>
				<ul class="about-info">
					<li>
						<span>Konum</span>
						<strong>İstanbul, Türkiye</strong>
					</li>
					<li>
						<span>Odak</span>
						<strong>Web · Mobil · Ürün</strong>
					</li>
					<li>
						<span>Araçlar</span>
						<strong>React · React Native · TypeScript</strong>
					</li>
					<li>
						<span>Hedef</span>
						<strong>Kendi yazılım şirketim</strong>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		background: #fff;
		color: rgb(var(--gray-dark));
	}

	/* ---- Hero ---- */
	.about-hero {
		background: rgb(var(--gray-light));
		padding-block: 4em;
		border-bottom: 1px solid rgb(var(--black), 8%);
	}

	.about-hero__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2em;
		max-width: 900px;
		margin-inline: auto;
	}

	.about-hero__photo {
		width: min(280px, 70vw);
		aspect-ratio: 1 / 1;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		margin-inline: auto;
	}

	.about-hero__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.about-eyebrow {
		display: inline-block;
		font-size: 0.78em;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.6em;
	}

	.about-hero__intro {
		text-align: center;
	}

	.about-hero__intro h1 {
		font-size: 3em;
		margin: 0 0 0.4em;
		line-height: 1.05;
		color: rgb(var(--black));
	}

	.about-hero__intro p {
		font-size: 1.15em;
		font-weight: 300;
		line-height: 1.7;
		margin: 0 0 1.5em;
		max-width: 46ch;
		color: rgb(var(--gray-dark));
	}

	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9em;
	}

	.about-actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7em 1.6em;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.btn-primary {
		background: var(--accent);
		color: #fff;
	}

	.btn-primary:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1px solid rgb(var(--gray-light));
	}

	.btn-secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* ---- Details ---- */
	.about-details {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3em;
		max-width: 900px;
		margin: 4em auto;
		align-items: start;
	}

	.about-details__text h2 {
		font-size: 1.8em;
		margin: 0 0 0.8em;
		color: rgb(var(--black));
	}

	.about-details__text p {
		font-size: 1.02em;
		font-weight: 300;
		line-height: 1.8;
		margin: 0 0 1.1em;
		color: rgb(var(--gray-dark));
	}

	.about-info {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.about-info li {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1em;
		padding: 1.1em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.about-info li:last-child {
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.about-info span {
		font-size: 0.74em;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.about-info strong {
		font-weight: 500;
		color: rgb(var(--black));
		text-align: right;
	}

	/* ---- Responsive ---- */
	@media (max-width: 720px) {
		.about-hero__inner {
			grid-template-columns: 1fr;
			gap: 2em;
			text-align: center;
			justify-items: center;
		}

		.about-hero__photo {
			width: min(300px, 80vw);
		}

		.about-hero__intro p {
			margin-inline: auto;
		}

		.about-actions {
			justify-content: center;
		}

		.about-details {
			grid-template-columns: 1fr;
			gap: 2.5em;
		}
	}
</style>
