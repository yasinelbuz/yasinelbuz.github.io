---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import placeholderImage from "../assets/blog-placeholder-1.jpg";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const latestPost = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];

const latestProject = {
	title: "Brand Identity Design",
	description:
		"Modern bir teknoloji girişimi için logo, tipografi, renk paleti ve görsel rehber içeren eksiksiz marka kimliği sistemi.",
	image: "/1.avif",
	link: "/projects",
};
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<!-- Hakkımda Section -->
			<section class="flow-section">
				<div class="flow-content">
					<h1>Selam, Ben Yasin 👋</h1>
					<p>
						İstanbul'da yaşayan, <strong>Javascript ekosistemi</strong> ile ilgilenen bir <strong>yazılım geliştiricisiyim</strong>.
						Günlerim yazılımda bir şeyler öğrenerek, kendi projelerime ve <strong>açık kaynak projelere</strong> katkı sağlayarak geçmektedir.
					</p>
					<p>
						<strong>Bahçeşehir Üniversitesi Bilgisayar Öğretmenliği</strong> mezunuyum, kısa bir dönem öğretmenlik tecrübem var ve bir dönem çocuklara Javascript dersleri anlatarak onların mantıksal zekasını geliştirmek için dersler anlattım.
					</p>
					<p>
						Gezmeyi, etkinliklere katılmayı ve <strong>yeni insanlar ile tanışmayı</strong> çok seviyorum. Düzenli olarak yaz kış demeden yürüyüşler yapıyorum.
					</p>
					<p>
						Son olarak, web platformlarında bir şeyler tasarlamayı çok seviyorum, gelecekte ise <strong>web platformlarında bir şeyler inşa etmeye</strong> devam edeceğimi düşünüyorum. Eğer benimle tanışmak ve soru sormak isterseniz lütfen çekinmeyin, cevap vereceğimden emin olabilirsiniz.
					</p>
					<p>
						Kendinize çok iyi bakın, görüşmek üzere.
					</p>
					<p class="about-more">
						Daha fazlası için <a href="/about">Hakkımda sayfasına göz atabilirsiniz →</a>
					</p>
				</div>
			</section>

			<!-- Şu An Section -->
			<section class="flow-section">
				<div class="section-header">
					<h3>Şu An Ne İle Uğraşıyorum?</h3>
					<span class="status-badge">
						<span class="status-dot"></span> Aktif
					</span>
				</div>
				<div class="flow-content">
					<p>
						Şu sıralar aktif olarak <strong>mobil uygulama</strong> ve <strong>oyun geliştirme dünyası</strong> ile ilgileniyor, bu alanlarda yeni projeler ve fikirler üretiyorum. Aynı zamanda yeni teknolojileri deneyimleyerek öğrendiklerimi ve sürecimi blog yazıları olarak belgeliyorum.
					</p>
					<p class="contact-note">
						Bir şey hakkında konuşmak ya da sadece selam vermek isterseniz, <a href="mailto:yasinelbuz@gmail.com">bana ulaşabilirsiniz.</a>
					</p>
				</div>
			</section>

			<!-- Teknolojiler Section -->
			<section class="flow-section">
				<h3>Kullandığım Teknolojiler</h3>
				<div class="tech-tags">
					<span class="tech-tag">JavaScript (ES6+)</span>
					<span class="tech-tag">TypeScript</span>
					<span class="tech-tag">HTML5</span>
					<span class="tech-tag">CSS3</span>
					<span class="tech-tag">React</span>
					<span class="tech-tag">Next.js</span>
					<span class="tech-tag">Astro</span>
					<span class="tech-tag">Vue.js</span>
					<span class="tech-tag">Svelte</span>
					<span class="tech-tag">Vite</span>
					<span class="tech-tag">Node.js</span>
					<span class="tech-tag">Tailwind CSS</span>
					<span class="tech-tag">Sass / SCSS</span>
					<span class="tech-tag">Redux</span>
					<span class="tech-tag">Zustand</span>
					<span class="tech-tag">TanStack Query (React Query)</span>
					<span class="tech-tag">REST API</span>
					<span class="tech-tag">GraphQL</span>
					<span class="tech-tag">Webpack / Rollup</span>
					<span class="tech-tag">Jest / Vitest</span>
					<span class="tech-tag">Git & GitHub</span>
					<span class="tech-tag">React Native</span>
					<span class="tech-tag">Flutter</span>
					<span class="tech-tag">Unity</span>
				</div>
			</section>

			<!-- Son Proje Section -->
			{
				latestProject && (
					<section class="flow-section">
						<h3>Son Proje</h3>
						<a class="card-item" href={latestProject.link}>
							<div class="card-item__body">
								<h4 class="card-item__title">{latestProject.title}</h4>
								<p class="card-item__desc">{latestProject.description}</p>
								<span class="card-item__link">Tüm Projeleri İncele →</span>
							</div>
							<div class="card-item__image">
								<img src={latestProject.image} alt={latestProject.title} />
							</div>
						</a>
					</section>
				)
			}

			<!-- Son Yazı Section -->
			{
				latestPost && (
					<section class="flow-section flow-section--last">
						<h3>Son Yazı</h3>
						<a
							class="card-item"
							href={`/blog/${latestPost.id}/`}
						>
							<div class="card-item__body">
								<p class="card-item__meta">
									<FormattedDate
										date={latestPost.data.pubDate}
									/>
								</p>
								<h4 class="card-item__title">
									{latestPost.data.title}
								</h4>
								{latestPost.data.description && (
									<p class="card-item__desc">
										{latestPost.data.description}
									</p>
								)}
								<span class="card-item__link">Yazıyı Oku →</span>
							</div>
							<div class="card-item__image">
								{latestPost.data.heroImage ? (
									<Image
										width={800}
										height={600}
										src={latestPost.data.heroImage}
										alt={latestPost.data.title}
									/>
								) : (
									<Image
										width={800}
										height={600}
										src={placeholderImage}
										alt={latestPost.data.title}
									/>
								)}
							</div>
						</a>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.flow-content h1 {
		font-size: 2.2em;
		margin-top: 0;
		margin-bottom: 0.6em;
		color: rgb(var(--black));
		display: inline-block;
		position: relative;
		padding-bottom: 8px;
	}

	.flow-content h1::after {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 5px;
		background-color: #1a1a1a;
		border-radius: 3px;
	}

	.about-more {
		margin-top: 1.5em;
		font-weight: 500;
	}

	.flow-section {
		padding-block: 2.8em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.flow-section--last {
		border-bottom: none;
		padding-bottom: 1em;
	}

	.flow-section h3 {
		font-size: 1.6em;
		color: rgb(var(--black));
		margin: 0 0 1.2em;
		font-family: var(--font-display);
		display: inline-block;
		position: relative;
		padding-bottom: 8px;
	}

	.flow-section h3::after {
		content: "";
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 5px;
		background-color: #1a1a1a;
		border-radius: 3px;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.2em;
	}

	.section-header h3 {
		margin: 0;
	}

	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.82em;
		font-weight: 500;
		color: #16a34a;
		background: rgba(22, 163, 74, 0.08);
		padding: 0.3em 0.7em;
		border-radius: 20px;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		background-color: #16a34a;
		border-radius: 50%;
		display: inline-block;
	}

	.flow-content p {
		margin: 0 0 1em;
		font-weight: 300;
		line-height: 1.75;
		color: rgb(var(--gray-dark));
		font-size: 1.05em;
	}

	.flow-content p:last-child {
		margin-bottom: 0;
	}

	.contact-note {
		margin-top: 1.2em;
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7em;
	}

	.tech-tag {
		font-size: 0.9em;
		font-weight: 400;
		color: rgb(var(--gray-dark));
		background: rgb(var(--gray-light));
		padding: 0.4em 0.85em;
		border-radius: 8px;
		border: 1px solid rgba(var(--black), 0.05);
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.tech-tag:hover {
		background: #ffffff;
		border-color: rgba(var(--black), 0.18);
		transform: translateY(-2px);
	}

	.card-item {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.2em;
		align-items: center;
		text-decoration: none;
		color: inherit;
	}

	.card-item__body {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}

	.card-item__meta {
		margin: 0;
		font-size: 0.82em;
		font-weight: 300;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.card-item__title {
		margin: 0;
		font-size: 1.55em;
		color: rgb(var(--black));
		line-height: 1.3;
		font-family: var(--font-display);
		transition: color 0.2s ease;
	}

	.card-item:hover .card-item__title {
		color: var(--accent);
	}

	.card-item__desc {
		margin: 0;
		font-weight: 300;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		font-size: 0.98em;
	}

	.card-item__link {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		margin-top: 0.3em;
		color: var(--accent);
		font-weight: 500;
		font-size: 0.95em;
		transition: transform 0.2s ease;
	}

	.card-item:hover .card-item__link {
		transform: translateX(4px);
	}

	.card-item__image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 12px;
	}

	.card-item__image img,
	.card-item__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 12px;
		transition: transform 0.4s ease;
	}

	.card-item:hover .card-item__image img,
	.card-item:hover .card-item__image :global(img) {
		transform: scale(1.03);
	}

	@media (max-width: 720px) {
		.flow-section {
			padding-block: 2em;
		}
		.card-item {
			grid-template-columns: 1fr;
			gap: 1.2em;
		}
	}
</style>
