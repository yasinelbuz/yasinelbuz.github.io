---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
		/>
		<style>
			.blog-header {
				text-align: center;
				padding: 3em 0 2em;
				border-bottom: 1px solid rgb(var(--black), 10%);
				margin-bottom: 2.5em;
			}

			.blog-header h1 {
				margin: 0 0 0.4em;
				font-size: 2.441em;
			}

			.blog-header p {
				margin: 0;
				font-weight: 300;
				line-height: 1.6;
				color: rgb(var(--gray));
				font-size: 1.1em;
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-list li {
				border-bottom: 1px solid rgb(var(--black), 10%);
				padding: 1.5em 0;
			}

			.post-list li:last-child {
				border-bottom: none;
			}

			.post-link {
				display: block;
				text-decoration: none;
				color: inherit;
			}

			.post-title {
				margin: 0 0 0.3em;
				font-size: 1.25rem;
				color: rgb(var(--black));
				line-height: 1.3;
				font-family: var(--font-display);
			}

			.post-link:hover .post-title {
				color: var(--accent);
			}

			.post-date {
				margin: 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
				font-weight: 300;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="container">
			<header class="blog-header">
				<h1>Notlar</h1>
				<p>
					Öğrendiklerimi, ürettiklerimi ve yol boyunca karşılaştığım
					şeylerin küçük bir arşivi.
				</p>
			</header>

			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a class="post-link" href={`/blog/${post.id}/`}>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
