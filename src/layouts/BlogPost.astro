---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"] & {
	showHeader?: boolean;
	showFooter?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	showHeader = true,
	showFooter = true,
} = Astro.props;
---

<html lang="tr">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage as any}
			ogType="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		<style>
			.hero-image {
				width: 100%;
			}
		.hero-image img {
			display: block;
			margin: 0 auto;
			border-radius: 0;
			box-shadow: none;
		}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 0.8em 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0.2em 0 0;
				font-size: 3.5em;
				line-height: 1.05;
			}
			.date {
				margin-bottom: 0.3em;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				font-weight: 300;
				letter-spacing: 0.03em;
				text-transform: uppercase;
			}
			.last-updated-on {
				font-style: italic;
			}
		.back {
			display: inline-flex;
			align-items: center;
			gap: 0;
			margin-bottom: 1em;
			padding: 0.5em 0;
			color: rgb(var(--black));
			text-decoration: none;
			font-weight: 300;
			letter-spacing: 0.02em;
			transition: opacity 0.2s ease;
		}
		.back:hover {
			color: rgb(var(--black));
			opacity: 0.7;
		}
		.back svg {
			width: 24px;
			height: 24px;
			fill: currentColor;
			transform: scaleX(-1);
		}
		</style>
	</head>

	<body>
		{showHeader && <Header />}
		<main class="container">
			<article>
				{!showHeader && (
					<a class="back" href="/blog">
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><path
								d="M4 11h12.17l-5.59-5.59L12 4l8 8-8 8-1.41-1.41L16.17 13H4z"
							></path></svg
						>
					</a>
				)}
				<div class="hero-image">
					{
						heroImage && (
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
							/>
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		{showFooter && <Footer />}
	</body>
</html>
